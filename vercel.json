{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300,
        "memory": 3008
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "APP_PASSWORD": {
      "description": "Login password for the application"
    },
    "SESSION_SECRET": {
      "description": "Flask session secret key"
    },
    "YOUTUBE_API_KEY": {
      "description": "YouTube Data API key (optional)"
    }
  }
}
